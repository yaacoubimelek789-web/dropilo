# Production on Hostinger VPS (EasyPanel). Copy to .env on the server.
# Never commit .env with real secrets.

APP_DEBUG=0
DB_PROFILE=local
# EasyPanel internal host (see dropilodb → Credentials → Internal Host)
DB_HOST=dropilo_dropilodb
DB_PORT=3306
DB_NAME=dropilo
DB_USER=mysql
DB_PASS=change_me_strong_password
DB_CHARSET=utf8mb4

APP_ENCRYPTION_KEY=
GEMINI_API_KEY=
FIABILO_ADD_TOKEN=
FIABILO_TRACKING_TOKEN=
META_ADS_ACCESS_TOKEN=
META_ADS_ACCOUNT_ID=

# Optional: force remote DB host when not using Docker sidecar
# DB_HOST=srv2038.hstgr.io
# DB_NAME=u631627980_dropilo
# DB_USER=u631627980_dropilo
# DB_PASS=your_hostinger_mysql_password
